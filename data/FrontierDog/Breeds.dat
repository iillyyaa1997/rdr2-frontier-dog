# Frontier Dog: breeds, traits, skills and hardening deeds. Shipped data: an update replaces this file; your dogs live
# in FrontierDog\Dogs\ and are never touched by an update.
#
# stats = strength, nose, stamina, courage, trainability. A pedigree card sums to 16; only a breed's natural 5 goes
# above 4. Ordinary dogs: 12 (no 5), ailing 8 (each 1-3), see plan D99-D111.
# traits = the pedigree trait mix (5 points). Trait prices: 1-3 points, 3 = signature.

breeds=australian,bloodhound,bluetick,collie,catahoula,chesapeake,foxhound,husky,labrador,mutt,poodle,shiba
skills=fetch,soft_mouth,trail,hold,point,flush,guard,ambush
deeds=hunt,fight,road,water,guard,command
traits=horse_herder,bloodhound_nose,bay_holder,fearless,huntress,tracker,soft_mouth,frugal,flusher,obedient,watchdog,affectionate,quick,tough,sharp_ears,grip,diver,long_retrieve,hauler,tidy,hardy,herbalist,tenacious

[Rolls]
# stray mix (D102, D119) and the trait roll of ordinary dogs (D101)
roll.pedigree=0.10
roll.ailing=0.15
roll.own_breed_trait=0.70
# shop: chance that a dog for sale is a pedigree (D117; mutts in shops are always ordinary)
shop.pedigree=0.25

[Traits]
trait.horse_herder.price=3
trait.bloodhound_nose.price=3
trait.bay_holder.price=3
trait.fearless.price=3
trait.huntress.price=3
trait.tracker.price=2
trait.soft_mouth.price=2
trait.frugal.price=2

[Deeds]
# mutt hardening by deeds (D125): stats and traits a deed grows; step = counter units per step
deed.hunt.stats=nose,strength
deed.hunt.traits=long_retrieve,tracker,huntress
deed.hunt.step=8
deed.fight.stats=courage
deed.fight.traits=grip,tough,fearless
deed.fight.step=4
deed.road.stats=stamina
deed.road.traits=quick,hardy,frugal
deed.road.step=10
deed.water.stats=stamina
deed.water.traits=diver
deed.water.step=5
deed.guard.stats=courage,nose
deed.guard.traits=watchdog,sharp_ears
deed.guard.step=5
deed.command.stats=trainability
deed.command.traits=obedient
deed.command.step=40

