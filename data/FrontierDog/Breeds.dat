# Shiba Inu: the husky model, red-white coat (preset 1), 72 %; habits are generic switches any breed could use (old D69)
shiba.model=a_c_doghusky_01
shiba.preset=1
shiba.scale=72
shiba.ini=EnableShiba
shiba.stats=2,4,3,5,2
shiba.traits=huntress,tidy,tenacious
shiba.bond3_traits=quick
shiba.price=240
shiba.habit.obey_delay_ms=2000,1000,0
shiba.habit.water_shy_bond=3
shiba.habit.min_fetch_quality=1
shiba.habit.watches_food=1
shiba.habit.shy_of_strangers=1
shiba.habit.zoomies_min=20
shiba.habit.sulk_after_groom=20
shiba.habit.camp_sleep_curled=1
shiba.habit.quiet_alert=1

[Huntress]
# small and medium wild game a huntress goes after on her own (three-star only, D50)
huntress.prey=a_c_rabbit_01,a_c_squirrel_01,a_c_chipmunk_01,a_c_pheasant_01,a_c_prairiechicken_01,a_c_turkey_01,a_c_turkey_02,a_c_turkeywild_01,a_c_duck_01,a_c_goosecanada_01,a_c_raccoon_01,a_c_fox_01,a_c_possum_01,a_c_badger_01,a_c_muskrat_01

[Regions]
# trait weights for strays by district (D106 idea 2): trait:multiplier
region.bayou_nwa=diver:3,long_retrieve:1.5
region.bluewater_marsh=diver:3,soft_mouth:1.5
region.grizzlies_east=hardy:2.5,frugal:2,tough:1.5
region.grizzlies_west=hardy:2.5,frugal:2,tough:1.5
region.heartlands=watchdog:2,horse_herder:1.5,obedient:1.5
region.scarlett_meadows=watchdog:2,affectionate:1.5
region.big_valley=tracker:2,flusher:1.5
region.cumberland_forest=tracker:2,bloodhound_nose:1.5
region.roanoke_ridge=tracker:1.5,hardy:1.5,fearless:1.5
region.great_plains=quick:2,flusher:1.5
region.tall_trees=tracker:2,hardy:1.5
